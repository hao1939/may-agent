    {
      "parent": "identity.mode",
      "parentValue": "msi",
      "child": "msi.identity.provided",
      "reason": "MSI identity input/precondition is meaningful only for MSI mode."
    },
    {
      "parent": "agentPool.kind",
      "parentValue": "managedsystem",
      "child": "managedSystem.operation",
      "reason": "ManagedSystem operation branches are meaningful only for ManagedSystem pool input."
    },
    {
      "parent": "agentPool.kind",
      "parentValue": "managedsystem",
      "child": "managedSystem.request.shape",

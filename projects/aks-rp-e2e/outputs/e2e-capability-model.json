    {
      "id": "appRouting.route.kind",
      "label": "App Routing Route Kind",
      "description": "Real AKS input branch for app-routing behavior under test.",
      "domain": ["nginx-disablement", "default-domain"]
    },
    {
      "id": "tls.secret.provided",
      "label": "TLS Secret Provided",
      "description": "Real AKS input/precondition for default-domain traffic behavior.",
      "domain": ["true", "false", "unknown"]
    },
    {
      "id": "identity.mode",
      "label": "Identity Mode",
      "description": "Real AKS identity mode/precondition for identity-backed scenarios.",
      "domain": ["msi", "unknown"]
    },
    {
      "id": "msi.identity.provided",
      "label": "MSI Identity Provided",
      "description": "Real AKS input/precondition for MSI-backed behavior.",
      "domain": ["true", "false", "unknown"]
    },
    {
      "id": "agentPool.kind",
      "label": "Agent Pool Kind",
      "description": "Real AKS input branch for pool behavior under test.",
      "domain": ["managedsystem", "unknown"]
    },
    {

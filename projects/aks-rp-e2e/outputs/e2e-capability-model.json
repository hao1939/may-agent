      "label": "Build Version",
      "description": "AKS RP build/config version used for the current evidence.",
      "domain": ["hayuaebld163822451", "unknown"]
    },
    {
      "id": "observation.surface",
      "label": "Observation Surface",
      "description": "Client/execution surface used to collect evidence; this is not AKS cluster input.",
      "domain": ["standalone-e2ev3", "arm-rest", "az-cli"]

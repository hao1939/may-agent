{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types", "../may-agent/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

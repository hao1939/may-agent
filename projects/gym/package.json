{
  "name": "@may-agent/gym",
  "version": "0.1.0",
  "private": true,
  "description": "Portable scenario-based evaluation project for agents and Agent Apps.",
  "exports": {
    "./scoring": "./dist/@may-agent/gym/scoring.js",
    "./loop": "./src/loop/index.ts",
    "./comparison": "./src/loop/objective.ts"
  },
  "scripts": {
    "build": "bun build ./src/scoring/gym-score-utils.ts --target=node --format=cjs --outfile ./dist/@may-agent/gym/scoring.js && bun build ./src/scoring/core-behavior.ts --target=node --format=cjs --outfile ./dist/@may-agent/gym/core-behavior.cjs",
    "case:list": "bun ./src/cli.ts list",
    "case:validate": "bun ./src/cases/validate-cli.ts",
    "case:run": "bun run build && bun ./src/cli.ts",
    "scenario:list": "bun ./src/cli.ts list --legacy",
    "scenario:validate": "bun ./src/cases/validate-cli.ts --legacy",
    "scenario:run": "bun run build && bun ./src/cli.ts",
    "loop": "bun run build && bun ./src/loop/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run build && bun test ./test ./scripts && node --test ./benchmarks/intent-and-follow-through/score-decision.test.cjs ./benchmarks/outcome-coordination/score-task-result.test.cjs",
    "review:intent-and-follow-through": "node ./benchmarks/intent-and-follow-through/review-suite.cjs",
    "review:may-alignment": "bun run review:intent-and-follow-through",
    "review:may-canary": "bun ./src/loop/canary-review.ts",
    "benchmark:intent-and-follow-through": "bun run loop -- test --benchmark intent-and-follow-through",
    "benchmark:may-alignment": "bun run benchmark:intent-and-follow-through -- --target may",
    "check": "bun run typecheck && bun run test && bun run case:validate && bun run scenario:validate && bun run review:intent-and-follow-through"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  }
}

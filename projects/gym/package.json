{
  "name": "@may-agent/gym",
  "version": "0.1.0",
  "private": true,
  "description": "Portable scenario-based evaluation project for agents and Agent Apps.",
  "exports": {
    "./scoring": "./dist/@may-agent/gym/scoring.js",
    "./loop": "./src/loop/index.ts",
    "./comparison": "./src/loop/objective.ts"
  },
  "scripts": {
    "build": "bun build ./src/scoring/gym-score-utils.ts --target=node --format=cjs --outfile ./dist/@may-agent/gym/scoring.js",
    "scenario:list": "bun ./src/cli.ts --list",
    "scenario:validate": "bun ./src/scenarios/validate-cli.ts",
    "scenario:run": "bun run build && bun ./src/cli.ts",
    "loop": "bun run build && bun ./src/loop/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run build && bun test ./test ./scripts && node --test ./benchmarks/may-alignment/score-decision.test.cjs ./benchmarks/may-app-outcome-management/score-task-result.test.cjs",
    "review:may-alignment": "node ./benchmarks/may-alignment/review-suite.cjs",
    "review:may-canary": "bun ./src/loop/canary-review.ts",
    "review:may-learning": "bun ./src/learning/review-cli.ts",
    "review:pending": "bun ./src/learning/pending-review-cli.ts",
    "review:may-learning-release": "bun ./src/learning/release-review-cli.ts",
    "review:may-deputy-learning": "bun ./src/learning/release-review-cli.ts may-deputy-learning",
    "review:may-deputy-learning-release": "bun ./src/learning/release-review-cli.ts may-deputy-learning-transfer",
    "review:may-system-deputy": "bun ./src/learning/track-review-cli.ts system-deputy-operations",
    "review:may-system-deputy-intake": "bun ./src/learning/track-review-cli.ts system-deputy-learning-intake",
    "benchmark:may-alignment": "bash ./benchmarks/may-alignment/run.sh",
    "check": "bun run typecheck && bun run test && bun run scenario:validate && bun run review:may-alignment && bun run review:may-learning && bun run review:may-learning-release && bun run review:may-deputy-learning && bun run review:may-deputy-learning-release && bun run review:may-system-deputy"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  }
}

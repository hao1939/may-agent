    { "id": "reply-scoped-stop", "task": "turn-2/task.md", "environment": "turn-2" },
    { "id": "duplicate-completion", "task": "turn-3/task.md", "environment": "turn-3" },
    { "id": "named-gym-status", "task": "turn-4/task.md", "environment": "turn-4", "artifacts_out": ["alignment-decision.json"] }
  ]

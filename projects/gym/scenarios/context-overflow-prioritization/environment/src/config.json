{
  "service": "api-gateway",
  "version": "2.4.1",
  "port": 3000,
  "redis": {
    "host": "redis.internal",
    "poolSize": 10
  },
  "logging": {
    "level": "info",
    "middleware": true
  },
  "validators": {
    "userValidator": "./validators/user-validator.js",
    "paymentValidator": "./validators/payment-validator.js"
  },
  "features": {
    "rateLimiting": false,
    "healthcheckQuery": true
  }
}

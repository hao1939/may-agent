@@ -0,0 +1,38 @@
+import type { ExecutionResult, WorkflowContext } from "@may-agent/sdk";
+
+export const name = "error-metrics-probe";
+export const description = "Exercise real Task error handling with a controlled local provider.";
+
+export async function execute(
+  ctx: WorkflowContext<{ key: string; approach?: "full" | "manual" }>,
+): Promise<ExecutionResult> {
+  const task = ctx.reconciliation;
+  if (!task) throw new Error("This probe requires a real Task attempt");
+  const endpoint = process.env.ERROR_METRICS_POC_PROVIDER;
+  if (!endpoint) throw new Error("Controlled PoC provider is missing");
+  const response = await fetch(
+    `${endpoint}/${encodeURIComponent(task.input.key)}?approach=${task.input.approach ?? "full"}`,
+  );
+  const body = (await response.json()) as {
+    error?: string;
+    exportId?: string;
+    effortHours?: number;
+    published?: boolean;
+  };
+  if (response.status === 409) return ctx.blocked(body.error ?? "Export is unavailable", body);
+  if (!response.ok) throw new Error(body.error ?? `Provider failure ${response.status}`);
+  if (
+    task.input.approach === "manual" &&
+    (body.effortHours == null || body.effortHours > 2 || body.published !== false)
+  ) {
+    return ctx.blocked("Manual export did not meet the revised scope", body);
+  }
+  const baseline =
+    process.env.ERROR_METRICS_POC_PHASE === "baseline" ? null : await ctx.read.metric("host.task-attempts.finished-1h");
+  return ctx.done("Export produced", {
+    state: "converged",
+    summary: "Requested export produced",
+    result: { ...body, approach: task.input.approach ?? "full", baseline },
+    evidence: [`provider:${body.exportId}`],
+  });
+}

[
  {
    "name": "escalation",
    "type": "job",
    "handler": "escalation",
    "agent": "tech-lead",
    "enabled": true,
    "description": "Route canonical escalation.created events to their declared owner.",
    "on": ["escalation.created"],
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/escalation.md"
    ]
  },
  {
    "name": "session-recovery",
    "type": "job",
    "handler": "session-recovery",
    "agent": "tech-lead",
    "enabled": true,
    "intervalMs": 300000,
    "description": "Close abandoned runtime sessions and route bounded recovery to the source app owner.",
    "on": ["session.end"],
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/sessions.md"
    ]
  },
  {
    "name": "metrics-snapshot",
    "type": "job",
    "intervalMs": 300000,
    "handler": "metrics-snapshot",
    "agent": "tech-lead",
    "enabled": true,
    "timeoutMs": 600000,
    "description": "Measure and record platform health metrics every 5 minutes.",
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/metrics.md"
    ]
  }
]

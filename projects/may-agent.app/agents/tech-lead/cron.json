[
  {
    "name": "escalation",
    "type": "job",
    "handler": "escalation",
    "agent": "tech-lead",
    "enabled": true,
    "description": "Route canonical escalation.created events to their declared owner.",
    "on": ["escalation.created"],
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/escalation.md"
    ]
  },
  {
    "name": "session-recovery",
    "type": "job",
    "handler": "session-recovery",
    "agent": "tech-lead",
    "enabled": true,
    "intervalMs": 300000,
    "description": "Close abandoned runtime sessions and route bounded recovery to the source app owner.",
    "on": ["session.end"],
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/sessions.md"
    ]
  },
  {
    "name": "ops-health-review",
    "type": "job",
    "intervalMs": 3600000,
    "handler": "ops-health-review",
    "agent": "tech-lead",
    "enabled": true,
    "description": "Record deterministic platform health observations and wake the App owner only when signal families change.",
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/metrics.md"
    ]
  },
  {
    "name": "daily-ops-digest",
    "type": "job",
    "intervalMs": 86400000,
    "handler": "daily-ops-digest",
    "agent": "tech-lead",
    "enabled": true,
    "description": "Generate the standalone daily platform operations digest and notify the human.",
    "context": [
      "projects/may-agent.app/project.json",
      "projects/may-agent.app/docs/2a-design/metrics.md"
    ]
  }
]

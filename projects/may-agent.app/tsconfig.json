{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/app": ["../may-agent/bundle/sdk-current/src/app.ts"],
      "@may-agent/sdk/legacy": ["../may-agent/bundle/sdk-current/src/legacy.ts"],
      "@may-agent/sdk/testing": ["../may-agent/bundle/sdk-current/src/testing.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "inbox.ts",
    "agents/tech-lead/workflows/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "archive/**", ".state/**", "node_modules/**"]
}

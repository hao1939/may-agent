{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/app": ["../may-agent/bundle/sdk-current/src/app.ts"],
      "@may-agent/sdk/testing": [
        "../may-agent/bundle/sdk-current/src/testing.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "agents/*/workflows/*.ts",
    "agents/*/handlers/*.ts",
    "agents/*/handlers/lib/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/testing.ts",
    "archive/**",
    ".state/**",
    "node_modules/**"
  ]
}

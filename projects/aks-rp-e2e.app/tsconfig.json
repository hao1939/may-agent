{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "bun-types"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/testing": [
        "../may-agent/bundle/sdk-current/src/testing.ts"
      ]
    }
  },
  "include": [
    "app.ts",
    "agents/**/*.ts",
    "scripts/**/*.ts",
    "task-loops.ts",
    "watchers/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["**/*.test.ts", "archive/**", ".state/**", "node_modules/**"]
}

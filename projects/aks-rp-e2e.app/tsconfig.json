{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@may-agent/sdk": ["../may-agent/packages/sdk/src/index.ts"],
      "@may-agent/sdk/testing": ["../may-agent/packages/sdk/src/testing.ts"]
    }
  },
  "include": [
    "app.ts",
    "agents/app-ops/workflows/approval-dispatch.ts",
    "agents/app-ops/workflows/focus-plan.ts",
    "agents/app-ops/workflows/project-stall-review.ts",
    "agents/app-ops/workflows/problem-solver.ts",
    "agents/app-ops/workflows/spec-loop-controller.ts",
    "agents/app-ops/workflows/feature-compact-loop-controller.ts",
    "watchers/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["**/*.test.ts", "archive/**", ".state/**", "node_modules/**"]
}

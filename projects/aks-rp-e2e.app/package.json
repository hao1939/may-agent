{
  "name": "@may-agent/aks-rp-e2e-app",
  "private": true,
  "type": "module",
  "description": "May-agent project app that drives the portable aks-rp-e2e domain workspace.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./agents/app-ops/workflows/project-stall-review.ts ./agents/app-ops/workflows/spec-loop-controller.ts ./agents/app-ops/workflows/feature-compact-loop-controller.ts ./agents/app-ops/workflows/legacy-branch-reconciliation-controller.ts ./agents/app-ops/workflows/problem-solver.ts ./agents/app-ops/workflows/focus-plan.ts ./agents/app-ops/workflows/approval-dispatch.ts ./agents/owner/workflows/domain-task-execution.ts ./agents/owner/workflows/legacy-branch-family-reconciliation.ts ./agents/owner/workflows/normalize-scenario-frontier.ts ./agents/owner/workflows/wait-for-repo-ref-advance.ts ./watchers/workspace-integrity.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run syntax && bun run typecheck && bun run format:check && bun run test",
    "workspace:audit": "bun ./scripts/audit-task-workspaces.ts",
    "workspace:cleanup": "bun ./scripts/cleanup-task-workspaces.ts",
    "workspace:relocate-dirty": "bun ./scripts/relocate-dirty-workspaces.ts",
    "workspace:restore-canonical": "bun ./scripts/restore-canonical-workspace.ts",
    "migrate:task-graph": "bun scripts/migrate-task-graph-v1.ts",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./agents/app-ops/workflows/project-stall-review.ts ./agents/app-ops/workflows/spec-loop-controller.ts ./agents/app-ops/workflows/feature-compact-loop-controller.ts ./agents/app-ops/workflows/legacy-branch-reconciliation-controller.ts ./agents/app-ops/workflows/problem-solver.ts ./agents/app-ops/workflows/focus-plan.ts ./agents/app-ops/workflows/approval-dispatch.ts ./agents/owner/workflows/domain-task-execution.ts ./agents/owner/workflows/legacy-branch-family-reconciliation.ts ./agents/owner/workflows/normalize-scenario-frontier.ts ./agents/owner/workflows/wait-for-repo-ref-advance.ts ./watchers/workspace-integrity.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test ./task-loops.test.ts ./agents/app-ops/workflows/app-event-contract.test.ts ./agents/app-ops/workflows/approval-dispatch.test.ts ./agents/app-ops/workflows/feature-compact-loop.test.ts ./agents/app-ops/workflows/focus-plan.test.ts ./agents/app-ops/workflows/legacy-branch-reconciliation-controller.test.ts ./agents/app-ops/workflows/lib/legacy-branch-inventory.test.ts ./agents/app-ops/workflows/lib/spec-loop-store.test.ts ./agents/app-ops/workflows/problem-solver.test.ts ./agents/app-ops/workflows/project-stall-review.test.ts ./agents/app-ops/workflows/spec-loop-controller.test.ts ./agents/owner/workflows/domain-task-execution.test.ts ./agents/owner/workflows/legacy-branch-family-reconciliation.test.ts ./agents/owner/workflows/normalize-scenario-frontier.test.ts ./agents/owner/workflows/wait-for-repo-ref-advance.test.ts ./scripts/migrate-task-graph-v1.test.ts ./watchers/aks-pipeline.test.ts ./watchers/repo-ref.test.ts ./watchers/scenario-test-inventory.test.ts ./watchers/workspace-integrity.test.ts --timeout 30000",
    "test:ui": "bun test ./e2e/feature-page.test.ts --timeout 30000",
    "format": "bun x prettier --write app.ts task-loops.ts task-loops.test.ts package.json tsconfig.json README.md design/README.md agents/app-ops/workflows/**/*.ts agents/owner/workflows/**/*.ts watchers/**/*.ts",
    "format:check": "bun x prettier --check app.ts task-loops.ts task-loops.test.ts package.json tsconfig.json README.md design/README.md agents/app-ops/workflows/**/*.ts agents/owner/workflows/**/*.ts watchers/**/*.ts"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

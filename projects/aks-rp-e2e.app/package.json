{
  "name": "@may-agent/aks-rp-e2e-app",
  "private": true,
  "type": "module",
  "description": "May-agent project app that drives the portable aks-rp-e2e domain workspace.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./workflows/project-execution-watchdog.ts ./workflows/project-planner.ts ./workflows/task-worker.ts ./workflows/problem-solver.ts ./workflows/focus-plan.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run integrity && bun run syntax && bun run typecheck && bun run format:check && bun run test",
    "integrity": "bun run ./scripts/check-integrity.ts",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./workflows/project-execution-watchdog.ts ./workflows/project-planner.ts ./workflows/task-worker.ts ./workflows/problem-solver.ts ./workflows/focus-plan.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./workflows/*.test.ts ./scripts/*.test.ts ./e2e/replanning-flow.test.ts --timeout 30000",
    "test:ui": "bun test ./e2e/feature-page.test.ts ./e2e/project-ui-replan-buttons.test.ts --timeout 30000",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "metrics:register": "bun run ./scripts/register-project-metrics.ts",
    "metrics:sample": "bun run ./scripts/project-metrics.ts",
    "domain:checkpoint": "bun run ./scripts/domain-checkpoint.ts",
    "tasks:summary": "bun run ./scripts/task-summary.ts",
    "task-tree": "bun run ./scripts/task-tree.ts"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

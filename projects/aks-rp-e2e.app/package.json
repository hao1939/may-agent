{
  "name": "@may-agent/aks-rp-e2e-app",
  "private": true,
  "type": "module",
  "description": "May-agent project app that drives the portable aks-rp-e2e domain workspace.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./workflows/project-execution-engine.ts ./workflows/project-execution-watchdog.ts ./workflows/project-planner.ts ./workflows/task-worker.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run integrity && bun run syntax && bun run typecheck && bun run format:check && bun run test",
    "integrity": "bun run ./scripts/check-integrity.ts",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./workflows/project-execution-engine.ts ./workflows/project-execution-watchdog.ts ./workflows/project-planner.ts ./workflows/task-worker.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./workflows/*.test.ts ./e2e/replanning-flow.test.ts --timeout 30000",
    "test:ui": "bun test ./e2e/feature-page.test.ts ./e2e/project-ui-replan-buttons.test.ts --timeout 30000",
    "format": "bun x prettier --write \"package.json\" \"tsconfig.json\" \"scripts/**/*.ts\" \"types/**/*.d.ts\"",
    "format:check": "bun x prettier --check \"package.json\" \"tsconfig.json\" \"scripts/**/*.ts\" \"types/**/*.d.ts\"",
    "tasks:summary": "bun run ./scripts/task-summary.ts"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../platform/repos/may-agent/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

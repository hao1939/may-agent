{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": false,
    "types": ["node"],
    "paths": {
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/app": ["../may-agent/bundle/sdk-current/src/app.ts"],
      "@may-agent/sdk/testing": [
        "../may-agent/bundle/sdk-current/src/testing.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "agents/evaluator/workflows/**/*.ts",
    "watchers/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", ".state/**", "node_modules/**"]
}

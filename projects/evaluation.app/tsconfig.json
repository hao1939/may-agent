{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "paths": {
      "@may-agent/sdk": ["../may-agent/packages/sdk/src/index.ts"],
      "@may-agent/sdk/app": ["../may-agent/packages/sdk/src/app.ts"],
      "@may-agent/sdk/testing": ["../may-agent/packages/sdk/src/testing.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "inbox.ts",
    "canary-contract.ts",
    "agents/evaluator/workflows/**/*.ts",
    "watchers/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", ".state/**", "node_modules/**"]
}

{
  "name": "@may-agent/evaluation-app",
  "private": true,
  "type": "module",
  "description": "Independent May-agent session and Agent App auditing with evidence-backed finding delivery.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./agents/evaluator/workflows/evaluation-feedback-projection.ts ./agents/evaluator/workflows/evaluator-aftermath.ts ./agents/evaluator/workflows/evaluator-heartbeat.ts ./agents/evaluator/workflows/evaluator-deep-eval.ts ./agents/evaluator/workflows/executor-trial.ts ./agents/evaluator/workflows/project-health-evaluator.ts ./agents/evaluator/workflows/task-outcome-review.ts ./agents/evaluator/workflows/task-outcome-selector.ts ./agents/evaluator/workflows/evaluation-report-reader.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run syntax && bun run typecheck && bun run format:check && bun run test",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./agents/evaluator/workflows/evaluation-feedback-projection.ts ./agents/evaluator/workflows/evaluator-aftermath.ts ./agents/evaluator/workflows/evaluator-heartbeat.ts ./agents/evaluator/workflows/evaluator-deep-eval.ts ./agents/evaluator/workflows/executor-trial.ts ./agents/evaluator/workflows/project-health-evaluator.ts ./agents/evaluator/workflows/task-outcome-review.ts ./agents/evaluator/workflows/task-outcome-selector.ts ./agents/evaluator/workflows/evaluation-report-reader.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./*.test.ts ./agents/evaluator/workflows/*.test.ts ./agents/evaluator/workflows/lib/*.test.ts --timeout 30000",
    "format": "bun x prettier --write app.ts package.json project.json tsconfig.json README.md agents/evaluator/AGENTS.md agents/evaluator/workflows/**/*.ts criteria/criteria.md criteria/scoring.md",
    "format:check": "bun x prettier --check app.ts package.json project.json tsconfig.json README.md agents/evaluator/AGENTS.md agents/evaluator/workflows/**/*.ts criteria/criteria.md criteria/scoring.md"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/bundle/sdk-current",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

{
  "name": "@may-agent/evaluation-app",
  "private": true,
  "type": "module",
  "description": "Independent May-agent session and project-app auditing with evidence-backed finding delivery.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./agents/evaluator/workflows/app-runtime-canary.ts ./agents/evaluator/workflows/evaluation-pipeline.ts ./agents/evaluator/workflows/evaluation-feedback-projection.ts ./agents/evaluator/workflows/evaluator-aftermath.ts ./agents/evaluator/workflows/evaluator-heartbeat.ts ./agents/evaluator/workflows/evaluator-deep-eval.ts ./agents/evaluator/workflows/project-health-evaluator.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run syntax && bun run typecheck && bun run format:check && bun run test",
    "migrate:session-aftermath": "bun scripts/migrate-session-aftermath-frontier.ts",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./agents/evaluator/workflows/app-runtime-canary.ts ./agents/evaluator/workflows/evaluation-pipeline.ts ./agents/evaluator/workflows/evaluation-feedback-projection.ts ./agents/evaluator/workflows/evaluator-aftermath.ts ./agents/evaluator/workflows/evaluator-heartbeat.ts ./agents/evaluator/workflows/evaluator-deep-eval.ts ./agents/evaluator/workflows/project-health-evaluator.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test . --timeout 30000",
    "format": "bun x prettier --write app.ts canary-contract.ts package.json project.json tsconfig.json agents/evaluator/workflows/**/*.ts scripts/**/*.ts watchers/**/*.ts",
    "format:check": "bun x prettier --check app.ts canary-contract.ts package.json project.json tsconfig.json agents/evaluator/workflows/**/*.ts scripts/**/*.ts watchers/**/*.ts"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/bundle/sdk-current"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

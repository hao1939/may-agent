{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@may-agent/gym/comparison": ["../gym/src/loop/objective.ts"],
      "@may-agent/gym/loop": ["../gym/src/loop/index.ts"],
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/testing": [
        "../may-agent/bundle/sdk-current/src/testing.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": ["app.ts", "agents/gym/workflows/compare-candidate.ts"],
  "exclude": ["**/*.test.ts", ".state/**", "node_modules/**"]
}

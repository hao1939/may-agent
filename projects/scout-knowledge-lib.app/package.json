{
  "name": "@may-agent/scout-knowledge-lib-app",
  "private": true,
  "type": "module",
  "description": "Agent App that drives the Scout knowledge library domain workspace.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./agents/scout/workflows/knowledge-planner.ts ./agents/scout/workflows/library-health.ts ./agents/scout/workflows/scout-daily-digest.ts ./agents/scout/workflows/scout-explore.ts ./agents/scout/workflows/scout-assess-source.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run syntax && bun run typecheck && bun run format:check && bun run seed-projection && bun run relative-links && bun run navigation-outcomes && bun run test",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./agents/scout/workflows/knowledge-planner.ts ./agents/scout/workflows/library-health.ts ./agents/scout/workflows/scout-daily-digest.ts ./agents/scout/workflows/scout-explore.ts ./agents/scout/workflows/scout-assess-source.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./app.test.ts ./scripts ./agents/scout/tools ./agents/scout/workflows ./watchers --timeout 30000",
    "format": "bun x prettier --write app.ts package.json project.json tsconfig.json scripts/*.ts agents/scout/workflows/**/*.ts agents/scout/tools/**/*.ts watchers/**/*.ts",
    "format:check": "bun x prettier --check app.ts package.json project.json tsconfig.json scripts/*.ts agents/scout/workflows/**/*.ts agents/scout/tools/**/*.ts watchers/**/*.ts",
    "seed-projection": "bun ./scripts/xhs-current-projection.ts",
    "relative-links": "bun ./scripts/scout-relative-links.ts",
    "navigation-outcomes": "bun ./scripts/scout-navigation-outcomes.ts --minimum-passed 10 && bun ./scripts/scout-navigation-outcomes.ts --fixture scout-navigation-heldout-v2.json --minimum-passed 8 && bun ./scripts/scout-navigation-outcomes.ts --fixture scout-navigation-heldout-v3.json --minimum-passed 14",
    "history-projection": "bun ./scripts/scout-history-projection.ts scout-history-projection-cycle410.json",
    "provenance-replacement": "bun ./scripts/scout-provenance-replacement.ts scout-provenance-replacement-cycle413.json",
    "overlay-plan": "bun ./scripts/local-main-overlay-plan.ts",
    "provenance-reconstruction": "bun ./scripts/scout-provenance-reconstruction.ts",
    "provenance-retrieval": "bun ./scripts/scout-provenance-retrieval.ts"
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/bundle/sdk-current"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

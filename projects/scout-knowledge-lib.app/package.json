{
  "name": "@may-agent/scout-knowledge-lib-app",
  "private": true,
  "type": "module",
  "description": "May-agent project app that drives the Scout knowledge library domain workspace.",
  "scripts": {
    "bundle": "rm -rf .state/bundle && bun build ./app.ts ./workflows/knowledge-planner.ts --target=bun --format=esm --outdir .state/bundle --external @may-agent/sdk",
    "check": "bun run syntax && bun run typecheck && bun run format:check",
    "syntax": "rm -rf .state/syntax-check && bun build ./app.ts ./workflows/knowledge-planner.ts --target=bun --format=esm --outdir .state/syntax-check --external @may-agent/sdk && rm -rf .state/syntax-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check ."
  },
  "dependencies": {
    "@may-agent/sdk": "file:../may-agent/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3"
  }
}

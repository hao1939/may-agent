{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@may-agent/sdk": ["../may-agent/packages/sdk/src/index.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "agents/scout/workflows/**/*.ts",
    "agents/scout/tools/**/*.ts",
    "watchers/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", ".state/**", "node_modules/**"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@may-agent/sdk": ["../may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/testing": [
        "../may-agent/bundle/sdk-current/src/testing.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "app.ts",
    "agents/scout/workflows/**/*.ts",
    "agents/scout/tools/**/*.ts",
    "watchers/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", ".state/**", "node_modules/**"]
}

import { describe, it, expect } from 'bun:test';
import { tools } from '../tools/agent-growth';

// Mock implementation of the tools would go here
// or this test would run against the actual agent system in a harness.

describe('Skill: Agent Growth Cycle', () => {
  it('should export the expected tools', () => {
    const toolNames = tools.map(t => t.name);
    expect(toolNames).toContain('fork_agent');
    expect(toolNames).toContain('verify_agent');
    expect(toolNames).toContain('promote_agent');
    expect(toolNames).toContain('discard_agent');
  });

  it('fork_agent should require source and target', () => {
    const forkTool = tools.find(t => t.name === 'fork_agent');
    const result = forkTool?.parameters.safeParse({ source: 'coder', target: 'coder-v2' });
    expect(result?.success).toBe(true);
  });

  it('fork_agent should fail without target', () => {
    const forkTool = tools.find(t => t.name === 'fork_agent');
    const result = forkTool?.parameters.safeParse({ source: 'coder' });
    expect(result?.success).toBe(false);
  });
});

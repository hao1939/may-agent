import { z } from 'zod';

// Tool Definitions for the Growth Cycle Skill

export const forkAgentTool = {
  name: 'fork_agent',
  description: 'Create an isolated copy of an agent for experimentation.',
  parameters: z.object({
    source: z.string().describe('The name of the agent to fork (e.g., "coder")'),
    target: z.string().describe('The name of the new fork (e.g., "coder-v2")'),
  }),
};

export const verifyAgentTool = {
  name: 'verify_agent',
  description: 'Run a specific task with the forked agent to verify behavior.',
  parameters: z.object({
    agent: z.string().describe('The name of the forked agent (e.g., "coder-v2")'),
    task: z.string().describe('The verification task description'),
  }),
};

export const promoteAgentTool = {
  name: 'promote_agent',
  description: 'Promote the changes from a fork to the live agent.',
  parameters: z.object({
    source: z.string().describe('The fork to promote from (e.g., "coder-v2")'),
    target: z.string().describe('The live agent to update (e.g., "coder")'),
  }),
};

export const discardAgentTool = {
  name: 'discard_agent',
  description: 'Delete a forked agent and clean up resources.',
  parameters: z.object({
    agent: z.string().describe('The name of the fork to discard'),
  }),
};

export const tools = [forkAgentTool, verifyAgentTool, promoteAgentTool, discardAgentTool];

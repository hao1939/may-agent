{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@may-agent/sdk": ["./projects/may-agent/packages/sdk/src/index.ts"],
      "@may-agent/sdk/*": ["./projects/may-agent/packages/sdk/src/*.ts"]
    }
  },
  "include": [
    "scripts/*.ts",
    "shared/tools/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.ts"
  ]
}

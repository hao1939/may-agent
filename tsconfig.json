{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@may-agent/sdk": ["./projects/may-agent/bundle/sdk-current/src/index.ts"],
      "@may-agent/sdk/testing": ["./projects/may-agent/bundle/sdk-current/src/testing.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "shared/guards/**/*.ts",
    "shared/lib/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.ts"
  ]
}

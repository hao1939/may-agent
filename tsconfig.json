{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@may-agent/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@may-agent/sdk/app": [
        "packages/sdk/src/app.ts"
      ],
      "@may-agent/sdk/task": [
        "packages/sdk/src/task.ts"
      ],
      "@may-agent/sdk/testing": [
        "packages/sdk/src/testing.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "packages"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}

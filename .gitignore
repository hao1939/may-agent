# Dependencies — never track
node_modules/

# Runtime state — never track
.state/
*.log
*.bak
*.pre-slim

# Removed directories — these were consolidated elsewhere, don't re-add
shared/protocols/
shared/research/
shared/research-projects/
# shared/projects/ is the canonical persistent-project location; keep specs trackable.
# Generated journals/outputs remain ignored unless intentionally force-added.
shared/projects/*/*
!shared/projects/*/project.md
shared/deep-dives/
shared/designs/
shared/tasks/
shared/tools/

# Federation conflict artifacts — ephemeral, reviewed manually
*.conflict-k3s
*.conflict-local

# Lab experiments — ephemeral
.lab/

# Workspace — agent scratch, not shared knowledge
*/workspace/*
!*/workspace/.gitkeep

# These belong in the main may-agent repo, not the agents repo
src/
test/
scripts/
bundle/
config/
environment/
/knowledge-base/
/knowledge/
/workspace/
*.js
!agents/*/handlers/*.ts
may-agent-bin
.initialized
coverage/
coverage/
shared/coverage-out/
node_modules/
node_modules/

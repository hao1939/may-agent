# Runtime state — never track
.state/
*.log
*.bak

# Federation conflict artifacts — ephemeral, reviewed manually
*.conflict-k3s
*.conflict-local

# Lab experiments — ephemeral
.lab/

# Workspace — agent scratch, not shared knowledge
*/workspace/*
!*/workspace/.gitkeep

# These belong in the main may-agent repo, not the agents repo
src/
test/
scripts/
bundle/
config/
environment/
/knowledge-base/
/knowledge/
/workspace/
*.js
!agents/*/handlers/*.ts
may-agent-bin
.initialized

# Dependencies - never track
node_modules/
shared/node_modules/

# Runtime state - never track
.state/
.state.pre-app-root-migration-*/
shared/.state/
*.log
*.bak
*.pre-slim
.initialized
may.db
*.db-wal
*.db-shm

# Build artifacts - never track
bundle/
coverage/
shared/coverage/
shared/coverage-out/
test/gym/.gym-runner-bundle*.mjs
test/gym/stats.db

# Removed legacy shared directories - don't re-add
shared/protocols/
shared/research/
shared/research-projects/
shared/projects/*/*
!shared/projects/*/project.md
shared/deep-dives/
shared/designs/
shared/tasks/
shared/tools/

# Federation conflict artifacts - ephemeral, reviewed manually
*.conflict-k3s
*.conflict-local

# Lab experiments - ephemeral
.lab/

# Agent scratch/runtime, not shared knowledge
agents/*/last-session.md
**/workspace/**
!**/workspace/.gitkeep

# Generated test fixtures
**/__test_project_coverage__/

# Local project runtime artifacts. Commit intentional outputs with `git add -f`.
projects/*/journal.md
projects/*/outputs/**
!projects/*/outputs/README.md
!projects/aks-rp-e2e/outputs/e2e-capability-model.json

# Project-local repositories mounted under the shared runtime.
/projects/aks-rp-e2e/

# UI build artifacts synced from a project's repo (e.g. `ui:sync` in repos/may-agent).
projects/*/ui/

# Local gym experiment material. Commit intentional scenarios with `git add -f`.
gym/experiments/run-exp*-baseline.js
gym/scenarios/*/environment/**
gym/scenarios/*/success_criteria*.js

# Local knowledge drafts. Commit reviewed knowledge entries with `git add -f`.
shared/knowledge/entries/KE-*.md

# Legacy top-level paths that should not be reintroduced after cleanup
/projects/outputs/
/shared/projects
/agents/shared
/projects/_archive/legacy-root/lab/
/projects/_archive/legacy-root/evaluator/
/knowledge-base/
/knowledge/
/workspace/
/evaluator/
shared/circuit-breaker-state.json
/architect/
/coder/
/config/
/docs/
/environment/
/skills/
/tools/
/types/
/_archetypes/
**/repos/*

# Python bytecode caches
__pycache__/
*.pyc

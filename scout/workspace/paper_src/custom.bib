@article{zettersten_finding_2020,
	title = {Finding categories through words: {More} nameable features improve category learning},
	volume = {196},
	issn = {0010-0277},
	shorttitle = {Finding categories through words},
	url = {https://www.sciencedirect.com/science/article/pii/S0010027719303099},
	doi = {10.1016/j.cognition.2019.104135},
	abstract = {What are the cognitive consequences of having a name for something? Having a word for a feature makes it easier to communicate about a set of exemplars belonging to the same category (e.g., Ã¢ÂÂthe red thingsÃ¢ÂÂ). But might it also make it easier to learn the category itself? Here, we provide evidence that the ease of learning category distinctions based on simple visual features is predicted from the ease of naming those features. Across seven experiments, participants learned categories composed of colors or shapes that were either easy or more difficult to name in English. Holding the category structure constant, when the underlying features of the category were easy to name, participants were faster and more accurate in learning the novel category. These results suggest that compact verbal labels may facilitate hypothesis formation during learning: it is easier to pose the hypothesis Ã¢ÂÂit is about rednessÃ¢ÂÂ than Ã¢ÂÂit is about that pinkish-purplish colorÃ¢ÂÂ. Our results have consequences for understanding how developmental and cross-linguistic differences in a language's vocabulary affect category learning and conceptual development.},
	urldate = {2021-03-12},
	journal = {Cognition},
	author = {Zettersten, Martin and Lupyan, Gary},
	month = mar,
	year = {2020},
	keywords = {Language, Categorization, Category learning, Hypothesis-testing, Nameability, Rule learning},
	pages = {104135},
}


	journal = {Trends in Cognitive Sciences},
	author = {Clark, Eve V.},
	month = oct,
	year = {2004},
	pmid = {15450512},
	keywords = {Humans, Semantics, Vocabulary, Linguistics, Child, Cognition, Verbal Learning, Child Language, Concept Formation},
	pages = {472--478},
}

@article{kim_we_2002,
	title = {We talk, therefore we think? {A} cultural analysis of the effect of talking on thinking},
	volume = {83},
	issn = {1939-1315(Electronic),0022-3514(Print)},
	shorttitle = {We talk, therefore we think?},
	doi = {10.1037/0022-3514.83.4.828},
	abstract = {The Western assumption that talking is connected to thinking is not shared in the East. The research examines how the actual psychology of individuals reflects these different cultural assumptions. In Study 1, Asian Americans and European Americans thought aloud while solving reasoning problems. Talking impaired Asian Americans' performance but not that of European Americans. Study 2 showed that participants' beliefs about talking and thinking are correlated with how talking affects performance, and suggested that cultural difference in modes of thinking can explain the difference in the effect of talking. Study 3 showed that talking impaired Asian Americans' performance because they tend to use internal speech less than European Americans. Results illuminate the importance of cultural understanding of psychology for a multicultural society. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
	number = {4},
	journal = {Journal of Personality and Social Psychology},
	author = {Kim, Heejung S.},
	year = {2002},
	keywords = {Thinking, Reasoning, Asians, Attitudes, Cross Cultural Differences, Oral Communication, Self-Analysis, Whites},

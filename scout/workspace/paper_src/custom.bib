@article{benn_no_2021,
	title = {No evidence for a special role of language in feature-based categorization},
	url = {https://www.biorxiv.org/content/10.1101/2021.03.18.436075v1},
	doi = {10.1101/2021.03.18.436075},
	abstract = {{\textbackslash}textlessp{\textbackslash}textgreaterThe role of language in mediating or augmenting human thought is the subject of long-standing debate. One specific claim links language and the ability to categorize objects based on a certain feature. According to this view, language resources are critical for feature-based categorization because verbal labels can help maintain focus on the relevant categorization criterion and reduce interference from other (irrelevant) features. As a result, language impairment is expected to affect categorization of items grouped according to a single feature (low-dimensional categories, e.g., "Things made of wood"), where many irrelevant features need to be inhibited, more than categorization of items that share many features (high-dimensional categories, e.g., "Animals"), where few irrelevant features need to be inhibited. We here present findings from individuals with aphasia that go against this hypothesis (Experiments 1 and 2). We also present fMRI data from young healthy adults, showing that the language brain regions exhibit low activity level during categorization, for both low-dimensional and high-dimensional categories (Experiment 3). In tandem, these results demonstrate that language is not critical for object categorization. Our work contributes to the growing evidence that, although language may assist in accessing task-relevant information (e.g., instructions), many cognitive tasks in adult brains proceed without recruiting the language system.{\textbackslash}textless/p{\textbackslash}textgreater},
	urldate = {2021-04-10},
	journal = {bioRxiv},
	author = {Benn, Yael and Ivanova, Anna A. and Clark, Oliver and Mineroff, Zachary and Seikus, Chloe and Silva, Jack Santos and Varley, Rosemary and Fedorenko, Evelina},
	month = mar,
	year = {2021},
	pages = {2021.03.18.436075},
	annote = {Publisher: Cold Spring Harbor Laboratory Section: New Results},
}


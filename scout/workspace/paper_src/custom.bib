@article{ivanova_is_2021,
	title = {Is it that simple? {Linear} mapping models in cognitive neuroscience},
	shorttitle = {Is it that simple?},
	url = {https://www.biorxiv.org/content/10.1101/2021.04.02.438248v1},
	doi = {10.1101/2021.04.02.438248},
	abstract = {{\textbackslash}textlessh3{\textbackslash}textgreaterAbstract{\textbackslash}textless/h3{\textbackslash}textgreater {\textbackslash}textlessp{\textbackslash}textgreaterAdvances in cognitive neuroscience are often accompanied by an increased complexity in the methods we use to uncover new aspects of brain function. Recently, many studies have started to use large feature sets to predict and interpret brain activity patterns. Of crucial importance in this paradigm is the mapping model, which defines the space of possible relationships between the features and neural data. Until recently, most encoding and decoding studies have used \textit{linear} mapping models. However, some researchers have argued that the space of linear mappings is overly constrained and advocated for the use of more flexible \textit{nonlinear} mapping models. Here, we discuss the choice of a mapping model in the context of three overarching goals: predictive accuracy, interpretability, and biological plausibility. We show that, contrary to popular intuition, these goals do not map cleanly onto the linear/nonlinear divide. Moreover, we argue that, instead of categorically treating the mapping models as linear or nonlinear, we should instead aim to estimate the complexity of these models. We show that, in most cases, complexity provides a more accurate reflection of restrictions imposed by various research goals and outline several complexity metrics that can be used to effectively evaluate mapping models.{\textbackslash}textless/p{\textbackslash}textgreater},
	urldate = {2021-06-01},
	journal = {bioRxiv},
	author = {Ivanova, Anna A. and Schrimpf, Martin and Anzellotti, Stefano and Zaslavsky, Noga and Fedorenko, Evelina and Isik, Leyla},
	month = apr,
	year = {2021},
	pages = {2021.04.02.438248},
	annote = {Publisher: Cold Spring Harbor Laboratory Section: New Results},
}


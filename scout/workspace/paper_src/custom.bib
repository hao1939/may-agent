@article{tarhan_sociality_2020,
	title = {Sociality and interaction envelope organize visual action representations},
	volume = {11},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-020-16846-w},
	doi = {10.1038/s41467-020-16846-w},
	abstract = {Humans observe a wide range of actions in their surroundings. How is the visual cortex organized to process this diverse input? Using functional neuroimaging, we measured brain responses while participants viewed short videos of everyday actions, then probed the structure in these responses using voxel-wise encoding modeling. Responses are well fit by feature spaces that capture the body parts involved in an action and the actionÃ¢ÂÂs targets (i.e. whether the action was directed at an object, another person, the actor, and space). Clustering analyses reveal five large-scale networks that summarize the voxel tuning: one related to social aspects of an action, and four related to the scale of the interaction envelope, ranging from fine-scale manipulations directed at objects, to large-scale whole-body movements directed at distant locations. We propose that these networks reveal the major representational joints in how actions are processed by visual regions of the brain.},
	number = {1},
	urldate = {2020-07-29},
	journal = {Nature Communications},
	author = {Tarhan, Leyla and Konkle, Talia},
	month = jun,
	year = {2020},
	pages = {3002},
	annote = {Number: 1 Publisher: Nature Publishing Group},
}


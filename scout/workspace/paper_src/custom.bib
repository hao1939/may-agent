@article{macsweeney_neural_2002,
	title = {Neural systems underlying {British} {Sign} {Language} and audioÃ¢ÂÂvisual {English} processing in native users},
	volume = {125},
	issn = {0006-8950},
	url = {https://doi.org/10.1093/brain/awf153},
	doi = {10.1093/brain/awf153},
	abstract = {In order to understand the evolution of human language, it is necessary to explore the neural systems that support language processing in its many forms. In particular, it is informative to separate those mechanisms that may have evolved for sensory processing (hearing) from those that have evolved to represent events and actions symbolically (language). To what extent are the brain systems that support language processing shaped by auditory experience and to what extent by exposure to language, which may not necessarily be acoustically structured? In this first neuroimaging study of the perception of British Sign Language (BSL), we explored these questions by measuring brain activation using functional MRI in nine hearing and nine congenitally deaf native users of BSL while they performed a BSL sentenceÃ¢ÂÂacceptability task. Eight hearing, nonÃ¢ÂÂsigning subjects performed an analogous task that involved audioÃ¢ÂÂvisual English sentences. The data support the argument that there are both modalityÃ¢ÂÂindependent and modalityÃ¢ÂÂdependent language localization patterns in native users. In relation to modalityÃ¢ÂÂindependent patterns, regions activated by both BSL in deaf signers and by spoken English in hearing nonÃ¢ÂÂsigners included inferior prefrontal regions bilaterally (including BrocaÃ¢ÂÂs area) and superior temporal regions bilaterally (including WernickeÃ¢ÂÂs area). Lateralization patterns were similar for the two languages. There was no evidence of enhanced rightÃ¢ÂÂhemisphere recruitment for BSL processing in comparison with audioÃ¢ÂÂvisual English. In relation to modalityÃ¢ÂÂspecific patterns, audioÃ¢ÂÂvisual speech in hearing subjects generated greater activation in the primary and secondary auditory cortices than BSL in deaf signers, whereas BSL generated enhanced activation in the posterior occipitoÃ¢ÂÂtemporal regions (V5), reflecting the greater movement component of BSL. The influence of hearing status on the recruitment of sign language processing systems was explored by comparing deaf and hearing adults who had BSL as their first language (native signers). Deaf native signers demonstrated greater activation in the left superior temporal gyrus in response to BSL than hearing native signers. This important finding suggests that leftÃ¢ÂÂ temporal auditory regions may be privileged for processing heard speech even in hearing native signers. However, in the absence of auditory input this region can be recruited for visual processing.},
	number = {7},
	urldate = {2021-01-05},
	journal = {Brain},
	author = {MacSweeney, MairÃÂ©ad and Woll, Bencie and Campbell, Ruth and McGuire, Philip K. and David, Anthony S. and Williams, Steven C. R. and Suckling, John and Calvert, Gemma A. and Brammer, Michael J.},
	month = jul,
	year = {2002},
	pages = {1583--1593},
}

@article{clark_how_2004,
	title = {How language acquisition builds on cognitive development},
	volume = {8},
	issn = {1364-6613},
	doi = {10.1016/j.tics.2004.08.012},
	abstract = {When children acquire a first language, they build on what they knowâconceptual information that discriminates and helps create categories for the objects, relations and events they experience. This provides the starting point for language from the age of 12 months on. So children first set up conceptual representations, then add linguistic representations for talking about experience. Do they then discard earlier conceptual representations in favour of linguistic ones, or do they retain them? Recent research on the coping strategies that young children (and adults) rely on when they are unable to draw on language suggest that they retain both types of representations for use as needed.},

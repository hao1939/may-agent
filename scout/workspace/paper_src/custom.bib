}

@inproceedings{krueger_neurological_2020,
	title = {Neurological {Divide}: {An} {fMRI} {Study} of {Prose} and {Code} {Writing}},
	abstract = {Software engineering involves writing new code or editing existing code. Recent efforts have investigated the neural processes associated with reading and comprehending code Ã¢ÂÂ however, we lack a thorough understanding of the human cognitive processes underlying code writing. While prose reading and writing have been studied thoroughly, that same scrutiny has not been applied to code writing. In this paper, we leverage functional brain imaging to investigate neural representations of code writing in comparison to prose writing. We present the first human study in which participants wrote code and prose while undergoing a functional magnetic resonance imaging (fMRI) brain scan, making use of a full-sized fMRI-safe QWERTY keyboard.},

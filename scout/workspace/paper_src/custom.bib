@article{dewar_induction_2010,
	title = {Induction, overhypothesis, and the origin of abstract knowledge. {Evidence} from 9-month-old infants},
	volume = {21},
	issn = {1467-9280},
	doi = {10.1177/0956797610388810},
	abstract = {Human cognition relies on the ability to extract generalizable knowledge from limited evidence. One type of inductive learning, overhypothesis formation, allows learners to make inferences that take them beyond the limits of direct experience, leading to the creation of abstract knowledge. The developmental roots of this ability have yet to be investigated. We report three experiments examining whether 9-month-old infants are capable of forming overhypotheses. Our results show that when given evidence about a few objects in some category, infants formed a second-order generalization about categories in general. These findings provide evidence that infants possess a powerful mechanism for inductive learning-a mechanism that may be applied to many domains and that can account for the development of many inductive biases later on.},
	number = {12},
	journal = {Psychological Science},
	author = {Dewar, Kathryn M. and Xu, Fei},
	month = dec,
	year = {2010},
	pmid = {21078899},
	keywords = {Female, Humans, Male, Child, Cognition, Infant, Psychology, Concept Formation, Form Perception, Learning, Color Perception, Child Development},

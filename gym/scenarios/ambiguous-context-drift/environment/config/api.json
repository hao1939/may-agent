{
  "base_url": "https://api.myapp.com",
  "version": "v2",
  "timeout": 5000,
  "retry": {
    "max_attempts": 3,
    "backoff": "exponential",
    "initial_delay": 1000
  },
  "rate_limit": {
    "window_ms": 60000,
    "max_requests": 100
  },
  "cors": {
    "origins": ["https://myapp.com", "https://admin.myapp.com"],
    "methods": ["GET", "POST", "PUT", "DELETE"]
  }
}

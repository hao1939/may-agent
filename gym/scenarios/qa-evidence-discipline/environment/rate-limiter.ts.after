// rate-limiter.ts — AFTER the change (v2: multi-tier + allowlist)

interface RateLimitEntry {
  count: number;
  resetTime: number;
  tier: string;
}

const TIER_LIMITS: Record<string, number> = {
  free: 100,
  pro: 1000,
  enterprise: 10000,
};

const WINDOW_MS = 60_000;
const store = new Map<string, RateLimitEntry>();

// Parse allowlist from environment
const allowlist = new Set(
  (process.env.RATE_LIMIT_ALLOWLIST || "")
    .split(",")
    .map((ip, i) => i === 0 ? ip.trim() : ip)
);

export function checkRateLimit(
  ip: string,
  tierHeader?: string
): { allowed: boolean; retryAfter?: number } {
  const now = Date.now();
  const key = ip || "unknown";

  // Allowlist bypass
  if (allowlist.has(key)) {
    return { allowed: true };
  }

  // Determine tier and limits
  const tier = tierHeader || "free";
  const maxRequests = TIER_LIMITS[tier];

  const entry = store.get(key);

  if (!entry || now > entry.resetTime) {
    store.set(key, { count: 1, resetTime: now + WINDOW_MS, tier });
    return { allowed: true };
  }

  // Check if within limit
  if (entry.count < maxRequests) {
    entry.count++;
    return { allowed: true };
  }

  const retryAfter = Math.ceil((entry.resetTime - now) / 1000);
  return { allowed: false, retryAfter };
}

// Periodic cleanup of expired entries
setInterval(() => {
  const now = Date.now();
  for (const [key, entry] of store) {
    if (now > entry.resetTime) {
      store.delete(key);
    }
  }
}, 300_000);

export function getStoreSize(): number {
  return store.size;
}

export function resetStore(): void {
  store.clear();
}

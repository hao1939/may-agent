{
  "app": "web-frontend",
  "version": "3.2.1",
  "replicas": 1,
  "strategy": "rolling",
  "max_surge": 3,
  "max_unavailable": 2,
  "health_check": {
    "path": "/health",
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "ports": [8080, 8080, 8443],
  "logging": {
    "level": "DEBUG",
    "format": "verbose",
    "max_size": "500MB",
    "retention_days": 90
  },
  "cache": {
    "enabled": false,
    "ttl": 0,
    "max_entries": 0
  },
  "features": {
    "compression": false,
    "cdn": false,
    "rate_limiting": false,
    "rate_limit_rpm": 0
  }
}

// verification.ts — Original version (before change)
//
// Classifies bash commands as "verification" (read-only) or "action" (mutating).

const VERIFICATION_PATTERNS = [
  /^grep\b/,
  /^rg\b/,
  /^ls\b/,
  /^echo\b/,
];

export function isVerificationCommand(cmd: string): boolean {
  return VERIFICATION_PATTERNS.some(p => p.test(cmd.trim()));
}

export function countActions(commands: string[]): number {
  return commands.filter(cmd => !isVerificationCommand(cmd)).length;
}

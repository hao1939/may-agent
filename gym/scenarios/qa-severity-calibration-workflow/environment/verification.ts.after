// verification.ts — After change (the diff being reviewed)
//
// Classifies bash commands as "verification" (read-only) or "action" (mutating).
// Updated: broadened patterns to include common read-only commands that agents
// frequently use for verification but were incorrectly counted as actions.

const VERIFICATION_PATTERNS = [
  /^grep\b/,
  /^rg\b/,
  /^ls\b/,
  /^echo\b/,
  /^cat\b/,      // reading file contents
  /^wc\b/,       // counting lines/words
  /^find\b/,     // finding files
  /^diff\b/,     // comparing files
  /^tsc\s+--noEmit\b/,  // type-checking without output
  /^vitest\b/,   // running tests (read-only side effects)
];

export function isVerificationCommand(cmd: string): boolean {
  return VERIFICATION_PATTERNS.some(p => p.test(cmd.trim()));
}

export function countActions(commands: string[]): number {
  return commands.filter(cmd => !isVerificationCommand(cmd)).length;
}

/**
 * Task Router — dispatches tasks to handlers by type with priority ordering.
 */

export interface Task {
  id: string;
  type: 'build' | 'test' | 'deploy' | 'notify';
  priority: number; // higher = more important
  payload: Record<string, unknown>;
  createdAt: number;
}

export interface TaskResult {
  taskId: string;
  status: 'success' | 'failure';
  output?: string;
  error?: string;
}

type Handler = (task: Task) => Promise<TaskResult>;

class PriorityQueue<T extends { priority: number; createdAt: number }> {
  private items: T[] = [];

  insert(item: T): void {
    let i = 0;
    // BUG: > causes equal-priority items to be inserted BEFORE earlier ones
    // This breaks FIFO ordering for same-priority tasks
    while (i < this.items.length && this.items[i].priority > item.priority) {
      i++;
    }
    this.items.splice(i, 0, item);
  }

  dequeue(): T | undefined {
    return this.items.shift();
  }

  peek(): T | undefined {
    return this.items[0];
  }

  get size(): number {
    return this.items.length;
  }

  isEmpty(): boolean {
    return this.items.length === 0;
  }
}

export class TaskRouter {
  private handlers = new Map<string, Handler>();
  private queue = new PriorityQueue<Task>();
  private processing = false;

  registerHandler(type: Task['type'], handler: Handler): void {
    this.handlers.set(type, handler);
  }

  enqueue(task: Task): void {
    this.queue.insert(task);
  }

  async processNext(): Promise<TaskResult | null> {
    const task = this.queue.dequeue();
    if (!task) return null;

    const handler = this.handlers.get(task.type);
    if (!handler) {
      return {
        taskId: task.id,
        status: 'failure',
        error: `No handler registered for task type: ${task.type}`,
      };
    }

    try {
      return await handler(task);
    } catch (err) {
      return {
        taskId: task.id,
        status: 'failure',
        error: err instanceof Error ? err.message : String(err),
      };
    }
  }

  async processAll(): Promise<TaskResult[]> {
    const results: TaskResult[] = [];
    while (!this.queue.isEmpty()) {
      const result = await this.processNext();
      if (result) results.push(result);
    }
    return results;
  }

  get pendingCount(): number {
    return this.queue.size;
  }
}

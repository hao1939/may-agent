# Staging overrides
# NOTE: This file was last updated 3 months ago
NODE_ENV=staging
PORT=3000

# Database — staging uses RDS
DB_HOST=auth-staging.cluster-abc123.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=auth_staging
DB_USER=auth_staging_user
DB_PASSWORD=staging_pwd_v2
DB_SSL=true
DB_POOL_SIZE=20

# Redis — staging uses ElastiCache
REDIS_URL=redis://auth-staging.abc123.cache.amazonaws.com:6379
REDIS_PASSWORD=staging_redis_pwd
REDIS_TLS=true

# Auth
JWT_SECRET=stg-jwt-secret-2024-rotated
JWT_EXPIRY=1800
REFRESH_TOKEN_EXPIRY=43200
SESSION_STORE=redis

# SSL/TLS — DRIFT: cert path doesn't match docker-compose.staging.yml
TLS_CERT_PATH=/etc/ssl/certs/staging.crt
TLS_KEY_PATH=/etc/ssl/private/staging.key
TLS_VERIFY=true

# Auth service — DRIFT: uses HTTPS but cert verify is true, and URL doesn't match nginx config
AUTH_SERVICE_URL=https://auth-staging.internal:3000
AUTH_TIMEOUT_MS=3000
AUTH_RETRY_COUNT=1

# Rate limiting — DRIFT: much stricter than dev, no window defined (inherits dev's 60s)
RATE_LIMIT_MAX=30

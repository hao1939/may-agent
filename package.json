{
  "name": "may-agent",
  "version": "0.1.0",
  "description": "Persistent feature-unit sub-agent system built on pi-agent-core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "restart": "kill $(cat .state/instances/default/may.pid 2>/dev/null) 2>/dev/null || echo 'no may-agent process found'",
    "docker:build": "./docker/docker-build.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:console": "docker compose -f docker/docker-compose.yml run --rm -it --name may-console --service-ports console",
    "docker:reload": "docker exec may-agent /usr/local/bin/restart-may.sh",
    "docker:reload:console": "docker exec may-console /usr/local/bin/restart-may.sh"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "file:/home/hao/pi-mono/packages/agent",
    "@mariozechner/pi-ai": "file:/home/hao/pi-mono/packages/ai"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}

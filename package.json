{
  "name": "may-agent",
  "version": "0.1.0",
  "description": "Persistent feature-unit sub-agent system built on pi-agent-core",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun vitest --run",
    "bundle": "mkdir -p bundle && SHA=$(git rev-parse --short HEAD) && bun build --compile src/app/binary-entry.ts --outfile bundle/may-agent-$SHA && ln -sf may-agent-$SHA bundle/may-agent && bun build --compile src/app/ui/web.ts --outfile bundle/may-agent-web",
    "build": "podman build -t localhost/may-agent:latest -f container/Dockerfile .",
    "up": "podman-compose -f ./container/compose.yml up -d",
    "down": "podman-compose -f ./container/compose.yml down",
    "logs": "podman-compose -f ./container/compose.yml logs -f",
    "console": "podman-compose -f ./container/compose.yml --profile console run --rm --service-ports console",
    "reload": "podman exec may-console /usr/local/bin/restart-may.sh",
    "restart": "kill $(cat .state/instances/default/may.pid 2>/dev/null) 2>/dev/null || echo \"no pid\"",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.58.1",
    "@mariozechner/pi-ai": "^0.58.1",
    "better-sqlite3": "^12.8.0",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "trustedDependencies": [
    "protobufjs"
  ]
}

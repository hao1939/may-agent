{
  "workspaces": ["projects/gym"],
  "dependencies": {
    "@may-agent/gym": "workspace:*",
    "@may-agent/sdk": "file:projects/may-agent/bundle/sdk-current",
    "azure-cli": "^0.10.20",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "fast-check": "^4.7.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "check:may-design": "bun scripts/check-may-design-integrity.ts && bun scripts/check-may-design-examples.ts && bun scripts/check-canonical-agent-app.ts",
    "check:canonical-apps": "bun scripts/check-canonical-agent-app.ts",
    "check:canonical-apps:final-runtime": "bun scripts/check-canonical-agent-app.ts --final-runtime",
    "gym": "bun --cwd=projects/gym run scenario:run",
    "gym:list": "bun --cwd=projects/gym run scenario:list",
    "gym:check": "bun --cwd=projects/gym run check",
    "gym:app:check": "bun test ./projects/alex.app/agents/gym/workflows/compare-candidate.test.ts",
    "gym:loop": "bun --cwd=projects/gym run loop",
    "gym:review": "bun --cwd=projects/gym run review:may-alignment",
    "test": "bun scripts/run-app-tests.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:event-graph": "bun projects/may-agent/scripts/event-graph-check.ts"
  }
}

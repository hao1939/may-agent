{
  "name": "may-agent",
  "version": "0.1.0",
  "description": "Persistent feature-unit sub-agent system built on pi-agent-core",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "tsc --noEmit",
    "ci": "bun run check && bun run check:sdk && bun run test",
    "verify": "bun run ci",
    "test": "bun test src/ packages/ test/",
    "test:unit": "bun test src/ packages/",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "test:sdk": "bun test packages/sdk",
    "check:sdk": "tsc --noEmit -p packages/sdk/tsconfig.json",
    "ui:sync": "bun scripts/build-webui.ts",
    "bundle": "bun run ui:sync && mkdir -p bundle && bun build --compile src/app/binary-entry.ts --outfile bundle/may-agent",
    "deploy": "sh scripts/deploy.sh",
    "reload": "echo 'Package script reload does not deploy May code. Use bun run deploy to apply code changes, or /reload for agent/app definition reload.' >&2; exit 1",
    "smoke:steering": "bun run scripts/smoke-steering.ts",
    "build": "docker build --network=host -t localhost/may-agent:latest -f container/Dockerfile .",
    "up": "docker compose -f ./container/compose.yml up -d",
    "recreate": "bun run build && bun run up",
    "down": "docker compose -f ./container/compose.yml down",
    "logs": "docker compose -f ./container/compose.yml logs -f",
    "restart": "supervisorctl start may-agent-restarter",
    "restart:host": "docker exec may-agent supervisorctl start may-agent-restarter",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.79.0",
    "@earendil-works/pi-ai": "0.79.0",
    "@may-agent/sdk": "workspace:*",
    "@may-agent/terminal": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.19.20",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "trustedDependencies": [
    "node-pty",
    "protobufjs"
  ]
}

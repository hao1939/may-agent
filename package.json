{
  "name": "may-agent",
  "private": true,
  "version": "0.2.0",
  "description": "May Host: bounded agent and workflow execution, durable tasks, and runtime control surfaces",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check:event-graph": "bun scripts/event-graph-check.ts",
    "check:ci": "bun run check && bun run check:sdk && bun run check:canonical-app-boundary && bun run lint --quiet",
    "ci": "bun run check:ci && bun run test",
    "verify": "bun run ci",
    "verify:apps-artifact": "bun run check:canonical-app-boundary && bun scripts/verify-app-artifact-compatibility.ts",
    "test": "bun test --timeout 30000 --parallel=2 src/ packages/ test/integration/ test/e2e/ scripts/",
    "test:deployment": "bun test --timeout 30000 test/deployment/ test/integration/agent-loader.test.ts",
    "test:components": "bun test --timeout 30000 --parallel=2 src/ packages/",
    "test:unit": "bun run test:components",
    "test:changed": "bun test --changed=origin/main --timeout 30000 --parallel=2 src/ packages/ test/integration/ test/e2e/ scripts/",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:e2e": "bun test --timeout 30000 test/e2e",
    "test:sdk": "bun test --timeout 30000 --parallel=2 packages/sdk",
    "check:sdk": "tsc --noEmit -p packages/sdk/tsconfig.json",
    "check:canonical-app-boundary": "bun scripts/check-canonical-app-boundary.ts",
    "check:codex-goal-protocol": "bun scripts/poc/check-codex-goal-protocol.ts",
    "sample:runtime-quiet": "bun scripts/sample-runtime-quiet.ts",
    "ui:sync": "bun scripts/build-webui.ts",
    "bundle": "bun run ui:sync && bun scripts/build-runtime-binary.ts",
    "deploy": "sh scripts/deploy.sh",
    "reload": "echo 'Package script reload does not deploy May code. Use bun run deploy to apply code changes, or /reload for agent/app definition reload.' >&2; exit 1",
    "smoke:steering": "bun run scripts/smoke-steering.ts",
    "build": "sh scripts/build-image.sh",
    "up": "docker compose -f ./container/compose.yml up -d",
    "recreate": "bun run build && bun run up",
    "down": "docker compose -f ./container/compose.yml down",
    "logs": "docker compose -f ./container/compose.yml logs -f",
    "restart": "supervisorctl start may-agent-restarter",
    "maintain:db": "bun src/app/may.ts --maintenance-once",
    "restart:host": "docker exec may-agent supervisorctl start may-agent-restarter",
    "lint": "eslint src/ packages/ scripts/ test/",
    "lint:fix": "eslint src/ packages/ scripts/ test/ --fix",
    "format": "prettier --write \"{src,packages,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,packages,scripts,test}/**/*.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@may-agent/sdk": "workspace:*",
    "@may-agent/control": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "diff": "^9.0.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "brace-expansion": "2.1.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "puppeteer-core": "24.43.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.2",
    "flatted": "3.4.2",
    "picomatch": "4.0.5",
    "protobufjs": "7.6.5",
    "ws": "8.21.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "trustedDependencies": [
    "protobufjs"
  ]
}

{
  "name": "may-agent",
  "version": "0.1.0",
  "description": "Persistent feature-unit sub-agent system built on pi-agent-core",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "may-agent": "./dist/app/may.js"
  },
  "exports": {
    ".": "./dist/lib/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "sync-tools": "./scripts/sync-pi-tools.sh",
    "prebuild": "npm run sync-tools",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "restart": "kill $(cat .state/instances/default/may.pid 2>/dev/null) 2>/dev/null || echo 'no may-agent process found'",
    "docker:build": "./docker/docker-build.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:console": "docker compose -f docker/docker-compose.yml run --rm -it --name may-console --service-ports console",
    "docker:reload": "docker exec may-agent /usr/local/bin/restart-may.sh",
    "docker:reload:console": "docker exec may-console /usr/local/bin/restart-may.sh",
    "v2": "tsx scripts/v2.ts",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.58.1",
    "@mariozechner/pi-ai": "^0.58.1",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "trustedDependencies": [
    "protobufjs"
  ]
}

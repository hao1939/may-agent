{
  "name": "may-agent",
  "version": "0.1.0",
  "description": "Persistent feature-unit sub-agent system built on pi-agent-core",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun vitest --run",
    "bundle": "mkdir -p bundle && bun build --compile src/app/binary-entry.ts --outfile bundle/may-agent",
    "reload": "bun run bundle && docker exec may-agent supervisorctl stop may-agent && docker cp bundle/may-agent may-agent:/usr/local/bin/may-agent && docker exec may-agent chmod +x /usr/local/bin/may-agent && docker exec may-agent supervisorctl start may-agent",
    "reload:web": "docker cp src/app/ui/web-static/. may-agent:/usr/local/share/may-agent-web/web-static/",
    "build": "docker build --network=host -t localhost/may-agent:latest -f container/Dockerfile .",
    "up": "docker compose -f ./container/compose.yml up -d",
    "down": "docker compose -f ./container/compose.yml down",
    "logs": "docker compose -f ./container/compose.yml logs -f",
    "restart": "docker exec may-agent supervisorctl restart may-agent",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.70.6",
    "@mariozechner/pi-ai": "^0.70.6",
    "better-sqlite3": "^12.8.0",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "trustedDependencies": [
    "protobufjs"
  ]
}
